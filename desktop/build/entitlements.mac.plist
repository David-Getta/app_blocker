<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- A hardened runtime alatt Apple Event küldéséhez (előtérben lévő app és
         aktív fül lekérdezése a képernyőidő-méréshez) ez a jogosultság kell. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- Az Electron futtatásához szükséges alapok hardened runtime mellett. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
